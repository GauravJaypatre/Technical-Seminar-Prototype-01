# LLM Baseline Client Configuration Template
# Copy this file to .env and insert your authentic API key.
# Note: Groq keys must use prefix 'gsk_', OpenRouter keys use prefix 'sk-or-'.

BASELINE_PROVIDER=groq
BASELINE_API_KEY=gsk_your_groq_api_key_here
BASELINE_MODEL=openai/gpt-oss-120b
BASELINE_BASE_URL=https://api.groq.com/openai/v1
BASELINE_MAX_RPM=8
